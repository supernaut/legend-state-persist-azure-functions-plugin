{
  "name": "@supernaut/legend-state-persist-azure-functions-plugin",
  "version": "1.1.0",
  "description": "A plugin for persisting legend state in Azure Functions",
  "author": {
    "name": "Johannes Axner",
    "email": "johannes@axner.org",
    "url": "https://www.axner.org"
  },
  "engines": {
    "node": ">= 24.0.0",
    "pnpm": ">= 10.0.0"
  },
  "homepage": "https://github.com/supernaut/legend-state-persist-azure-functions-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supernaut/legend-state-persist-azure-functions-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/supernaut/legend-state-persist-azure-functions-plugin/issues"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "ci": "pnpm run check-format && pnpm run lint && pnpm run test && pnpm run build",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "local-release": "changeset version && changeset publish",
    "prepublishOnly": "pnpm run ci",
    "release": "pnpm changeset publish",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:ci": "eslint --fix --quiet ."
  },
  "keywords": [
    "legend state",
    "azure functions"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "volta": {
    "node": "24.19.0",
    "pnpm": "11.20.0"
  },
  "devDependencies": {
    "@azure/functions": "^4.16.2",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@legendapp/state": "v3.0.0-beta.48",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.9.0",
    "lefthook": "^2.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2"
  },
  "peerDependencies": {
    "@azure/functions": "^4.0.0",
    "@legendapp/state": "^3.0.0-beta.48"
  },
  "peerDependenciesMeta": {
    "@azure/functions": {
      "optional": true
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
